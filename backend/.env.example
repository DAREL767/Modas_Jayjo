# Required application settings. Use real values only in your local .env or secret store.
APP_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DATABASE_NAME=modas_jayjo_db
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated Google OAuth client IDs for the web and/or mobile clients.
# Google login stays disabled if this is empty.
GOOGLE_CLIENT_IDS=

# Required only when the database has no active admin.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PASSWORD=
