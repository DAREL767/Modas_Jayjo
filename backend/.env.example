# Required application settings. Use real values only in your local .env or secret store.
APP_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# Optional DNS servers for environments where the OS resolver cannot resolve MongoDB SRV records.
MONGODB_DNS_NAMESERVERS=
DATABASE_NAME=modas_jayjo_db
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OAuth client ID allowlist for the responsive React web app (comma-separated if needed).
# Google login stays disabled if this is empty.
GOOGLE_CLIENT_IDS=
CORS_ORIGINS=http://localhost:5173
# The primary production Vercel origin https://modasjayjo.vercel.app is always allowed.

# Required only when the database has no active admin.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PASSWORD=
